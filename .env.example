NODE_ENV=development #Среда запуска приложения. Локально 'development'. На рабочем сервере задаётся 'production'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillswap
DB_USER=skillswap_app
DB_PASSWORD=skillswap
DB_SYNCHRONIZE=true #Если true, то при запуске приложения будет синхронизироваться структура базы данных с сущностями. На рабочем сервере всегда false
DB_LOGGING=true #Если true, то будут логироваться все запросы к базе данных. На рабочем сервере всегда false